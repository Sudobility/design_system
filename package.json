{
  "name": "@sudobility/design",
  "version": "1.1.67",
  "description": "Design system library with tokens, colors, typography and variants",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js",
      "default": "./dist/themes/index.js"
    }
  },
  "react-native": "./dist/index.native.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build && node scripts/fix-esm-imports.mjs",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts --fix && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "design-system",
    "tokens",
    "typography",
    "colors",
    "variants",
    "typescript"
  ],
  "author": "John Q Huang",
  "type": "module",
  "peerDependencies": {
    "clsx": ">=2.0.0",
    "tailwind-merge": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~4.1.12",
    "ajv": "~8.20.0",
    "clsx": "~2.1.1",
    "eslint": "~9.39.5",
    "jsdom": "~27.4.0",
    "prettier": "~3.9.10",
    "tailwind-merge": "~3.7.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/design_system.git"
  },
  "bugs": {
    "url": "https://github.com/sudobility/design/issues"
  },
  "homepage": "https://github.com/sudobility/design#readme",
  "license": "BUSL-1.1"
}
